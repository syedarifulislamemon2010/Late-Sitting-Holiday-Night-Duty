{
  "name": "admin-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --no-deprecation --require ./polyfill.js node_modules/next/dist/bin/next dev",
    "build": "node --no-deprecation --require ./polyfill.js node_modules/next/dist/bin/next build --webpack",
    "start": "node --no-deprecation --require ./polyfill.js node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "sbom": "npx @cyclonedx/cyclonedx-npm --output-file bom.json",
    "db:seed": "npx tsx src/db/seed.ts",
    "db:dump": "npx tsx src/db/dump.ts",
    "db:push": "npx drizzle-kit push",
    "db:migrate-passwords": "npx tsx src/db/migrate-passwords.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:contract": "vitest run src/**/*.contract.test.ts",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@next/swc-wasm-nodejs": "^16.4.2",
    "bcryptjs": "^3.0.3",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "isomorphic-dompurify": "^4.6.0",
    "lucide-react": "^1.45.0",
    "next": "^16.4.3",
    "next-auth": "^4.24.15",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
