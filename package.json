{
  "name": "admin-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --no-deprecation --require ./polyfill.js node_modules/next/dist/bin/next dev",
    "build": "node --no-deprecation --require ./polyfill.js node_modules/next/dist/bin/next build",
    "start": "node --no-deprecation --require ./polyfill.js node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "db:seed": "npx tsx src/db/seed.ts",
    "db:dump": "npx tsx src/db/dump.ts",
    "db:push": "npx drizzle-kit push",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:contract": "vitest run src/**/*.contract.test.ts",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "next-auth": "^4.24.15",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
