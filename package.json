{
  "name": "admin-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "set NODE_OPTIONS=--no-deprecation && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "npx tsx src/db/seed.ts",
    "db:dump": "npx tsx src/db/dump.ts",
    "postinstall": "node -e \"const fs = require('fs'); const path = require('path'); const p = path.join('node_modules', 'next', 'dist', 'bin', 'next'); if (fs.existsSync(p)) { let c = fs.readFileSync(p, 'utf8'); c = c.replace(/>=20.9.0/g, '>=18.0.0'); fs.writeFileSync(p, c); console.log('Successfully patched Next.js Node version check for compatibility with Node v18!'); }\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.107.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-auth": "^4.24.14",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
