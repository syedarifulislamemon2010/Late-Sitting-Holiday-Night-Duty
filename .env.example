# Database Configuration Example (.env)
# ==============================================================================
# JANATA BANK PLC. DUTY PORTAL - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# 1. DATABASE CONFIGURATION (REQUIRED)
# Direct connection string for PostgreSQL (RHEL local / remote / Neon).
# Example: postgresql://postgres:SecurePassword123@127.0.0.1:5432/duty_portal_prod
DATABASE_URL=postgresql://username:password@127.0.0.1:5432/duty_portal

# 2. AUTHENTICATION & SESSION SECURITY (REQUIRED)
# Strong random secret used by NextAuth to sign and encrypt session cookies and JWT tokens.
# Generate via: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_key_here

# Canonical base URL of the portal application.
# Local development: http://localhost:3000
# Production: https://duty.janatabank-bd.com
NEXTAUTH_URL=http://localhost:3000

# 3. PROXY & REVERSE PROXY SECURITY (OPTIONAL / PRODUCTION)
# Set to 'true' only when running behind an authentic reverse proxy (nginx) that properly
# sanitizes and forwards X-Forwarded-For / X-Real-IP headers.
# Defaults to false in proxy.ts to prevent header spoofing when directly exposed.
TRUST_PROXY_HEADERS=false

# 4. AUTOMATED BACKUP CRON SECRET (REQUIRED FOR SCHEDULED BACKUPS)
# Secret bearer token required to invoke /api/backup/cron endpoint.
# Header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your_secure_cron_secret_key_here

# 5. BACKUP ENCRYPTION KEY (OPTIONAL)
# Symmetric AES-256-GCM key used if database dumps are encrypted before storage.
# Generate via: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=your_backup_encryption_hex_key_here

# 6. SEEDING GUARD (DEVELOPMENT ONLY / OPTIONAL)
# Guardrail: prevents accidental DB wipe in production. Set to 'true' to allow npm run db:seed.
# In production, leave unset or 'false'.
ALLOW_SEED=false

# 7. AI SERVICES (OPTIONAL)
# Google Gemini API key used for parsing roster schedule images and holidays.
GEMINI_API_KEY=your_gemini_api_key_here

# 8. ERROR & ALERT WEBHOOK (OPTIONAL)
# Outbound webhook URL (Mattermost / Slack / Teams) to receive critical server error alerts.
ERROR_WEBHOOK_URL=https://chat.janatabank-bd.com/hooks/your_webhook_token

# 9. RBAC AUDIT MODE (OPTIONAL)
# Mode for Role-Based Access Control assessment: 'audit' (default) or 'off'.
# In audit mode, unauthorized actions are logged with [RBAC AUDIT] without blocking requests.
# Set to 'off' to disable RBAC audit evaluation and logging completely.
RBAC_MODE=audit
