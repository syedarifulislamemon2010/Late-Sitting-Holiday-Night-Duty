# Database configuration (Neon / PostgreSQL)
DATABASE_URL=postgresql://username:password@hostname:port/dbname?sslmode=require

# Authentication configuration (Auth.js / NextAuth)
NEXTAUTH_SECRET=your_nextauth_secret_key_here
NEXTAUTH_URL=http://localhost:3000

# Gemini API configuration for parsing images/holidays
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase configuration for Realtime updates
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
