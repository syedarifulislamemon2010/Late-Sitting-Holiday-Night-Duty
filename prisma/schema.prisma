datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Cell {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  employees   Employee[]
  users       User[]     @relation("UserCells")
  lunchBills  LunchBill[]
  createdAt   DateTime   @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String
  role      String   @default("USER") // ADMIN or USER
  mobile    String?
  cells     Cell[]   @relation("UserCells")
  feedbacks Feedback[]
  messages  FeedbackMessage[]
  leaveApplications LeaveApplication[]
  chatParticipants ChatParticipant[]
  chatMessages     ChatMessage[]
  notifications    Notification[]
  createdAt DateTime @default(now())
}

model Employee {
  id          Int      @id @default(autoincrement())
  name        String
  designation String
  bankId      String?
  fileNo      String?
  mobile      String?
  cellId      Int
  cell        Cell     @relation(fields: [cellId], references: [id])
  duties      Duty[]
  createdAt   DateTime @default(now())
}

model Duty {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        String   // LATE_SITTING, HOLIDAY, NIGHT_SHIFT
  date        String   // YYYY-MM-DD
  description String?
  allowance1  Float    // Snacks / Lunch / Dinner based on type
  allowance2  Float    // Meal / Snacks / Early Meal based on type
  totalBill   Float    // Total allowance
  orderRef    String?
  createdAt   DateTime @default(now())

  @@index([orderRef])
}

model Document {
  id          Int      @id @default(autoincrement())
  name        String
  filePath    String
  fileSize    Int
  uploadedAt  DateTime @default(now())
}

model OfficeOrder {
  id           Int      @id @default(autoincrement())
  orderRef     String   @unique
  orderDate    String
  category     String
  employeeName String
  cellName     String?
  dutiesJson   String
  contentJson  String?
  status       String   @default("Printed")
  createdAt    DateTime @default(now())

  @@index([orderRef])
}

model Holiday {
  id           Int      @id @default(autoincrement())
  date         String   @unique // YYYY-MM-DD
  name         String
  isWorkingDay Boolean  @default(false) // If true, overrides a weekend to be a working day
  createdAt    DateTime @default(now())
}

model Executive {
  id          Int      @id @default(autoincrement())
  name        String
  designation String   // মহাব্যবস্থাপক (জিএম), উপ-মহাব্যবস্থাপক (ডিজিএম), সহকারী মহাব্যবস্থাপক (এজিএম)
  phone       String?
  email       String?
  bankId      String?
  fileNo      String?
  createdAt   DateTime @default(now())
}

model Trash {
  id         Int      @id @default(autoincrement())
  entityType String   // EMPLOYEE, CELL, DUTY, EXECUTIVE, DOCUMENT
  entityId   Int
  name       String   // Descriptive name to display in the Recycle Bin UI
  data       String   // Serialized JSON of record details
  deletedBy  String?  // Username of the user who deleted it
  deletedAt  DateTime @default(now())
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  username   String
  action     String   // LOGIN, CREATE, UPDATE, DELETE, CHANGE_PASSWORD
  entityType String?  // USER, EMPLOYEE, CELL, DUTY, EXECUTIVE, HOLIDAY, DOCUMENT
  entityId   String?
  ipAddress  String?
  macAddress String?
  userAgent  String?
  details    String
  createdAt  DateTime @default(now())
}

model Feedback {
  id          Int               @id @default(autoincrement())
  title       String
  category    String            // "FEEDBACK" (ফিডব্যাক ও পরামর্শ) or "ISSUE" (সমস্যা ও সমাধান)
  status      String            @default("PENDING") // "PENDING", "REVIEWED", "RESOLVED"
  userId      Int
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  messages    FeedbackMessage[]
}

model FeedbackMessage {
  id            Int      @id @default(autoincrement())
  feedbackId    Int
  feedback      Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  senderId      Int
  sender        User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  message       String
  attachmentUrl String?  // Stored path of screenshot attachments
  createdAt     DateTime @default(now())
}

model LeaveApplication {
  id              Int      @id @default(autoincrement())
  leaveType       String   // "CASUAL", "POST_FACTO", "STATION_LEAVE"
  startDate       String   // YYYY-MM-DD
  endDate         String   // YYYY-MM-DD
  applicationDate String   // YYYY-MM-DD
  
  // Applicant Info
  applicantName   String
  designation     String
  bankId          String
  fileNo          String?
  cellName        String
  leaveLocation   String
  mobileNo        String
  selectedDistrict String?
  
  // Delegate Covering Officer
  delegateId      String?
  
  // Leaves balance sheet numbers
  casualTotal     Int
  casualUsed      Int
  ordinaryTotal   Int
  ordinaryUsed    Int
  specialTotal    Int
  specialUsed     Int
  
  // Relationship
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())

  @@index([userId])
}

model Chat {
  id           Int               @id @default(autoincrement())
  type         String            // "DIRECT" (1-on-1) or "GROUP" (Multiple)
  name         String?           // Only for GROUP chat
  avatar       String?           // Optional group image path
  creatorId    Int?              // Admin/creator user ID of group
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  participants ChatParticipant[]
  messages     ChatMessage[]
}

model ChatParticipant {
  id         Int      @id @default(autoincrement())
  chatId     Int
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt   DateTime @default(now())
  lastReadAt DateTime @default(now())
  
  @@unique([chatId, userId])
}

model ChatMessage {
  id              Int      @id @default(autoincrement())
  chatId          Int
  chat            Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderId        Int
  sender          User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  message         String   // Text content (stored transparently encrypted via AES-256)
  attachmentUrl   String?  // File attachment relative path
  attachmentName  String?  // Original filename
  attachmentSize  Int?     // Size in bytes
  isUnsent        Boolean  @default(false) // Unsent for everyone
  deletedForUsers String   @default("[]")  // JSON array of user IDs who deleted this message "for me"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LunchBill {
  id           Int      @id @default(autoincrement())
  month        String   // YYYY-MM
  cellId       Int
  cell         Cell     @relation(fields: [cellId], references: [id], onDelete: Cascade)
  workingDays  Int
  recordsJson  String   // JSON string of records
  generatedBy  String   // Username of creator
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([month, cellId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?  // Navigation path, e.g. "/lunch-bill"
  createdAt DateTime @default(now())

  @@index([userId])
}


