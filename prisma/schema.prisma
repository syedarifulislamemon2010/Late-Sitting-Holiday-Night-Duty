datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Cell {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  employees   Employee[]
  users       User[]     @relation("UserCells")
  createdAt   DateTime   @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String
  role      String   @default("USER") // ADMIN or USER
  cells     Cell[]   @relation("UserCells")
  createdAt DateTime @default(now())
}

model Employee {
  id          Int      @id @default(autoincrement())
  name        String
  designation String
  bankId      String?
  fileNo      String?
  cellId      Int
  cell        Cell     @relation(fields: [cellId], references: [id])
  duties      Duty[]
  createdAt   DateTime @default(now())
}

model Duty {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        String   // LATE_SITTING, HOLIDAY, NIGHT_SHIFT
  date        String   // YYYY-MM-DD
  description String?
  allowance1  Float    // Snacks / Lunch / Dinner based on type
  allowance2  Float    // Meal / Snacks / Early Meal based on type
  totalBill   Float    // Total allowance
  orderRef    String?
  createdAt   DateTime @default(now())

  @@index([orderRef])
}

model Document {
  id          Int      @id @default(autoincrement())
  name        String
  filePath    String
  fileSize    Int
  uploadedAt  DateTime @default(now())
}

model OfficeOrder {
  id           Int      @id @default(autoincrement())
  orderRef     String   @unique
  orderDate    String
  category     String
  employeeName String
  cellName     String?
  dutiesJson   String
  contentJson  String?
  status       String   @default("Printed")
  createdAt    DateTime @default(now())

  @@index([orderRef])
}

model Holiday {
  id           Int      @id @default(autoincrement())
  date         String   @unique // YYYY-MM-DD
  name         String
  isWorkingDay Boolean  @default(false) // If true, overrides a weekend to be a working day
  createdAt    DateTime @default(now())
}

model Executive {
  id          Int      @id @default(autoincrement())
  name        String
  designation String   // মহাব্যবস্থাপক (জিএম), উপ-মহাব্যবস্থাপক (ডিজিএম), সহকারী মহাব্যবস্থাপক (এজিএম)
  phone       String?
  email       String?
  createdAt   DateTime @default(now())
}

model Trash {
  id         Int      @id @default(autoincrement())
  entityType String   // EMPLOYEE, CELL, DUTY, EXECUTIVE, DOCUMENT
  entityId   Int
  name       String   // Descriptive name to display in the Recycle Bin UI
  data       String   // Serialized JSON of record details
  deletedBy  String?  // Username of the user who deleted it
  deletedAt  DateTime @default(now())
}


